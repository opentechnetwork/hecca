    <style>
        :root {
            --gold: #D4A64A;
            --deep-black: #0F0F0F;
            --soft-white: #F7F7F7;
            --pink: #E84C7F;
            --blue: #3A6FB0;
            --sky: #A7C7F2;
            --tan: #C8A97E;
            --beige: #F5E9D2;
            --card: #1a1a1a;
        }

        * { box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--deep-black);
            color: var(--soft-white);
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        .font-display { font-family: 'Cormorant Garamond', Georgia, serif; }
        .font-body { font-family: 'Montserrat', Arial, sans-serif; }

        /* Gold divider */
        .gold-divider {
            border: none;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 0;
        }

        /* Monogram glow */
        .monogram-glow {
            text-shadow: 0 0 40px rgba(212,166,74,0.6), 0 0 80px rgba(212,166,74,0.3), 0 0 120px rgba(212,166,74,0.15);
        }

        .monogram-ring {
            box-shadow: 0 0 30px rgba(212,166,74,0.4), 0 0 60px rgba(212,166,74,0.2), inset 0 0 30px rgba(212,166,74,0.1);
        }

        .pink-glow { box-shadow: 0 0 30px rgba(232,76,127,0.5), 0 0 60px rgba(232,76,127,0.2), inset 0 0 20px rgba(232,76,127,0.1); }
        .blue-glow { box-shadow: 0 0 30px rgba(58,111,176,0.5), 0 0 60px rgba(58,111,176,0.2), inset 0 0 20px rgba(58,111,176,0.1); }
        .tan-glow { box-shadow: 0 0 30px rgba(200,169,126,0.5), 0 0 60px rgba(200,169,126,0.2), inset 0 0 20px rgba(200,169,126,0.1); }

        /* Leopard pattern overlay */
        .leopard-pattern {
            position: relative;
        }
        .leopard-pattern::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background-image: radial-gradient(ellipse 8px 10px at 20% 30%, rgba(139,90,43,0.35) 0%, transparent 100%),
                              radial-gradient(ellipse 6px 8px at 60% 20%, rgba(139,90,43,0.3) 0%, transparent 100%),
                              radial-gradient(ellipse 9px 7px at 40% 70%, rgba(139,90,43,0.35) 0%, transparent 100%),
                              radial-gradient(ellipse 7px 9px at 75% 55%, rgba(139,90,43,0.3) 0%, transparent 100%),
                              radial-gradient(ellipse 5px 7px at 15% 65%, rgba(139,90,43,0.25) 0%, transparent 100%),
                              radial-gradient(ellipse 8px 6px at 85% 80%, rgba(139,90,43,0.3) 0%, transparent 100%);
            pointer-events: none;
            opacity: 0.7;
        }

        /* Section fade in */
        .section-header {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .section-header.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Scroll indicator bounce */
        @keyframes bounce-down {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(10px); }
        }
        .scroll-indicator { animation: bounce-down 2s ease-in-out infinite; }

        /* Nav link active */
        .nav-link { transition: color 0.3s ease; }
        .nav-link.active { color: var(--gold) !important; }

        /* Toast */
        .toast-notification {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--gold);
            color: var(--deep-black);
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 13px;
            z-index: 9999;
            transition: transform 0.3s ease;
            pointer-events: none;
        }
        .toast-notification.show {
            transform: translateX(-50%) translateY(0);
        }

        /* Swatch hover */
        .color-swatch {
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .color-swatch:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(212,166,74,0.15);
        }

        /* Card hover */
        .brand-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .brand-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(212,166,74,0.1);
        }

        /* Sticky nav */
        #sticky-nav-a1b2 {
            transform: translateY(-100%);
            transition: transform 0.4s ease;
        }
        #sticky-nav-a1b2.visible {
            transform: translateY(0);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--deep-black); }
        ::-webkit-scrollbar-thumb { background: var(--gold); border-radius: 3px; }

        /* Gold bullet list */
        .gold-bullet li::before {
            content: '◆';
            color: var(--gold);
            margin-right: 0.75rem;
            font-size: 8px;
            vertical-align: middle;
        }

        .gold-dash li::before {
            content: '—';
            color: var(--gold);
            margin-right: 0.75rem;
        }

        /* Shopify mockup */
        .shopify-mockup { border: 1px solid rgba(212,166,74,0.2); border-radius: 8px; overflow: hidden; }

        /* Print tag */
        .hang-tag {
            width: 120px;
            height: 180px;
            position: relative;
        }
        .hang-tag::before {
            content: '';
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid var(--gold);
        }
    </style>
</head>
