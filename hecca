        const heroSection = document.getElementById('hero-k9m2');
        const stickyNav = document.getElementById('sticky-nav-a1b2');
        const mobileMenu = document.getElementById('mobile-menu-m7j4');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn-n8k3');
        const mobileMenuClose = document.getElementById('mobile-menu-close-b5v6');

        function handleNavVisibility() {
            if (!heroSection || !stickyNav) return;
            const heroBottom = heroSection.getBoundingClientRect().bottom;
            if (heroBottom <= 0) {
                stickyNav.classList.remove('hidden');
                stickyNav.classList.add('visible');
            } else {
                stickyNav.classList.remove('visible');
                setTimeout(function() {
                    if (!stickyNav.classList.contains('visible')) {
                        stickyNav.classList.add('hidden');
                    }
                }, 400);
            }
        }

        window.addEventListener('scroll', handleNavVisibility, { passive: true });

        // Mobile menu toggle
        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', function() {
                mobileMenu.classList.remove('hidden');
            });
        }
        if (mobileMenuClose) {
            mobileMenuClose.addEventListener('click', function() {
                mobileMenu.classList.add('hidden');
            });
