            { id: 'typography-s5', link: 'typography-s5' },
            { id: 'imagery-s6', link: 'imagery-s6' },
            { id: 'brand-voice-s7', link: 'brand-voice-s7' },
            { id: 'shopify-s8', link: 'shopify-s8' },
            { id: 'collections-s9', link: 'collections-s9' },
            { id: 'texture-s10', link: 'texture-s10' },
            { id: 'visual-s11', link: 'visual-s11' }
        ];

        function updateActiveNav() {
            var scrollPos = window.scrollY + 120;
            var activeId = '';
            sections.forEach(function(s) {
                var el = document.getElementById(s.id);
                if (el && el.offsetTop <= scrollPos) {
                    activeId = s.link;
                }
            });
            document.querySelectorAll('.nav-link').forEach(function(link) {
                if (link.getAttribute('href') === '#' + activeId) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        }

        window.addEventListener('scroll', updateActiveNav, { passive: true });

        // ========== SECTION HEADER FADE-IN ==========
        var sectionHeaders = document.querySelectorAll('.section-header');
        if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.2 });
            sectionHeaders.forEach(function(header) {
                observer.observe(header);
            });
        } else {
            sectionHeaders.forEach(function(h) { h.classList.add('visible'); });
        }

        // ========== COLOR SWATCH COPY ==========
        var toast = document.getElementById('toast-hex-c3d4');
        var toastTimer = null;

        document.querySelectorAll('.color-swatch').forEach(function(swatch) {
            swatch.addEventListener('click', function() {
                var hex = swatch.getAttribute('data-hex');
                if (!hex) return;

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(hex).then(function() {
                        showToast(hex);
                    }).catch(function() {
                        fallbackCopy(hex);
                    });
                } else {
                    fallbackCopy(hex);
                }
            });
        });

        function fallbackCopy(text) {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
            showToast(text);
        }

        function showToast(hex) {
            if (!toast) return;
            toast.textContent = 'Copied ' + hex + '!';
            toast.classList.add('show');
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(function() {
                toast.classList.remove('show');
            }, 2000);
        }
    </script>
</body>
</html>